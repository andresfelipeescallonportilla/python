# Configuración de la base de datos MySQL (XAMPP / phpMyAdmin local).
#
# Copia este archivo como ".env" (mismo nombre, solo cambia la extensión) y
# ajusta los valores si tu instalación de XAMPP es diferente.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#
# Si el archivo .env no existe, la aplicación usa estos mismos valores por
# defecto, así que no es obligatorio crearlo.

# Servidor MySQL (XAMPP por defecto: localhost:3306)
DB_HOST=localhost
DB_PORT=3306

# Usuario de phpMyAdmin (XAMPP por defecto: root sin contraseña)
DB_USER=root
DB_PASSWORD=

# Base de datos del proyecto.
# Opciones:
#   gestormascotasbd        -> la base creada con schema.sql (por defecto)
#   administracionmascotasbd -> la base que ya tenías del proyecto Java
DB_NAME=gestormascotasbd

# Driver de Python a usar: mysql-connector-python o pymysql
DB_DRIVER=mysql-connector-python
